// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────
//  ENUMS
// ─────────────────────────────────────────────────────────
enum UserStatus {
  ACTIVE
  INACTIVE
  BANNED
  SUSPENDED
}

enum SubscriptionPlan {
  free
  pro
  elite
}

enum SessionStatus {
  scheduled     // session booked, upcoming
  completed     // proof uploaded + buddy confirmed
  missed        // 3hr window passed, no proof uploaded
}

enum MessageType {
  text
  image
  session_invite
  proof
  system
}

enum NotificationType {
  match
  session
  proof
  chat
  token
  xp
  payment
  subscription
  system
}

enum SwipeAction {
  like
  skip
  super_like
}

enum UploadFolder {
  avatars
  proofs
  covers
}

// ─────────────────────────────────────────────────────────
//  USER
// ─────────────────────────────────────────────────────────
model User {
  id                 String           @id @default(uuid())
  email              String           @unique
  passwordHash       String
  firstName          String
  lastName           String
  username           String?          @unique
  phone              String?
  avatarUrl          String?          @db.Text
  bio                String?          @db.Text
  country            String?
  city               String?
  latitude           Decimal?         @db.Decimal(10,8)
  longitude          Decimal?         @db.Decimal(11,8)

  // Status
  status             UserStatus       @default(ACTIVE)
  emailVerified      Boolean          @default(false)
  isBanned           Boolean          @default(false)
  loginCount         Int              @default(0)
  lastLoginAt        DateTime?
  lastActiveAt       DateTime?

  // Fitness profile
  gender             String?
  walkthroughSeen    Boolean          @default(false)
  primaryActivity    String?
  activities         Json             @default("[]")
  experienceLevel    String?
  goals              Json             @default("[]")
  primaryGym         String?
  searchRadius       Int              @default(10)

  // Gamification
  xpTotal            Int              @default(0)
  weeklyXp           Int              @default(0)
  monthlyXp          Int              @default(0)
  level              Int              @default(1)
  chatTokens         Int              @default(20)
  trustScore         Decimal          @default(30.00) @db.Decimal(5,2)
  idVerified         Boolean          @default(false)

  // Influencer
  isInfluencer            Boolean   @default(false)
  instagramHandle         String?                     // All users can add (optional)
  instagramFollowers      Int?                        // Verified followers (admin set)
  influencerBio           String?   @db.Text          // Fitness niche description
  instagramVerifiedAt     DateTime?                   // When IG was verified by admin
  influencerAppliedAt     DateTime?                   // When they applied
  influencerSessionLimit  Int       @default(3)        // Max sessions/month fans can book

  // Subscription
  subscriptionPlan   SubscriptionPlan @default(free)
  subscriptionExpiry DateTime?

  // Timestamps
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  deletedAt          DateTime?

  // Relations
  refreshTokens        RefreshToken[]
  swipesGiven          Swipe[]            @relation("SwiperSwipes")
  swipesReceived       Swipe[]            @relation("SwipedSwipes")
  matchesA             Match[]            @relation("MatchUserA")
  matchesB             Match[]            @relation("MatchUserB")
  sessionsAsUser       WorkoutSession[]   @relation("SessionUser")
  sessionsAsBuddy      WorkoutSession[]   @relation("SessionBuddy")
  messagesSent         Message[]
  chatsA               Chat[]             @relation("ChatUserA")
  chatsB               Chat[]             @relation("ChatUserB")
  notifications        Notification[]
  orders               Order[]
  uploads              Upload[]
  dailySwipes          DailySwipe[]
  xpEvents             XpEvent[]
  challengeEntries     ChallengeEntry[]   @relation("UserChallenges")
  buddyChallenges      ChallengeEntry[]   @relation("BuddyChallenges")
  challengeFeedPosts   ChallengeFeedPost[] @relation("UserFeedPosts")
  sessionParticipants  SessionParticipant[] @relation("SessionParticipants")
  chatMemberships      ChatMember[]        @relation("ChatMembers")
  strikesSent          BuddyStrike[]       @relation("StrikeSender")
  strikesReceived      BuddyStrike[]       @relation("StrikeReceiver")
  influencerApplication InfluencerApplication?  @relation("UserApplication")
  influencerSessions   InfluencerSession[]      @relation("InfluencerSessions")
  fanSessions          InfluencerSession[]      @relation("FanSessions")

  @@index([email])
  @@index([city])
  @@index([latitude, longitude])
  @@index([subscriptionPlan])
  @@index([primaryActivity])
  @@index([isInfluencer])
  @@map("users")
}

// ─────────────────────────────────────────────────────────
//  AUTH
// ─────────────────────────────────────────────────────────
model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  // FIX: Text cannot be unique in MySQL — use VARCHAR(500)
  token     String   @unique @db.VarChar(500)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ─────────────────────────────────────────────────────────
//  MATCHING
// ─────────────────────────────────────────────────────────
model Swipe {
  id         String      @id @default(uuid())
  swiperId   String
  swipedId   String
  action     SwipeAction
  createdAt  DateTime    @default(now())

  swiper     User        @relation("SwiperSwipes", fields: [swiperId], references: [id], onDelete: Cascade)
  swiped     User        @relation("SwipedSwipes", fields: [swipedId], references: [id], onDelete: Cascade)

  @@unique([swiperId, swipedId])
  @@index([swiperId])
  @@index([swipedId])
  @@map("swipes")
}

model Match {
  id                 String    @id @default(uuid())
  userAId            String
  userBId            String
  status             String    @default("active") // active | unmatched
  buddyStrikeStreak  Int       @default(0)         // Strike 2 streak count
  strikeCount        Int       @default(0)         // Total strikes sent
  lastStrikeAt       DateTime?                     // Last strike sent timestamp
  createdAt          DateTime  @default(now())

  userA     User         @relation("MatchUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB     User         @relation("MatchUserB", fields: [userBId], references: [id], onDelete: Cascade)
  chat      Chat?
  strikes   BuddyStrike[]

  @@unique([userAId, userBId])
  @@index([userAId])
  @@index([userBId])
  @@map("matches")
}

// ─────────────────────────────────────────────────────────
//  SESSIONS
// ─────────────────────────────────────────────────────────
model WorkoutSession {
  id               String        @id @default(uuid())
  userId           String
  buddyId          String?       // kept for 2-person sessions
  activity         String
  gymName          String?
  scheduledAt      DateTime
  durationMins     Int           @default(60)  // 45 | 60 | 90 | 120
  endTime          DateTime      // scheduledAt + durationMins
  status           SessionStatus @default(scheduled)
  proofImageUrl    String?       @db.Text
  proofVideoUrl    String?       @db.Text
  proofUploadedAt  DateTime?
  xpEarned         Int?
  tokensDeducted   Int?
  notes            String?       @db.Text
  incompleteReason String?
  challengeId      String?       // linked challenge if any
  chatId           String?       // group chat if group session
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  user             User          @relation("SessionUser",  fields: [userId],  references: [id], onDelete: Cascade)
  buddy            User?         @relation("SessionBuddy", fields: [buddyId], references: [id], onDelete: SetNull)
  challenge        Challenge?    @relation("WorkoutChallenge", fields: [challengeId], references: [id], onDelete: SetNull)
  participants     SessionParticipant[]

  @@index([userId])
  @@index([buddyId])
  @@index([status])
  @@index([scheduledAt])
  @@index([endTime])
  @@index([challengeId])
  @@map("workout_sessions")
}

// Group session participants (up to 10)
model SessionParticipant {
  id          String   @id @default(uuid())
  sessionId   String
  userId      String
  status      String   @default("pending") // pending | confirmed | declined
  respondedAt DateTime?
  createdAt   DateTime @default(now())

  session     WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user        User           @relation("SessionParticipants", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@index([sessionId])
  @@index([userId])
  @@map("session_participants")
}

// ─────────────────────────────────────────────────────────
//  CHAT
// ─────────────────────────────────────────────────────────
model Chat {
  id            String    @id @default(uuid())
  matchId       String?   @unique   // null for group chats
  userAId       String?             // null for group chats
  userBId       String?             // null for group chats
  isGroup       Boolean   @default(false)
  groupName     String?
  lastMessage   String?   @db.Text
  lastMessageAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  match         Match?    @relation(fields: [matchId],  references: [id], onDelete: Cascade)
  userA         User?     @relation("ChatUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB         User?     @relation("ChatUserB", fields: [userBId], references: [id], onDelete: Cascade)
  messages      Message[]
  members       ChatMember[]

  @@index([userAId])
  @@index([userBId])
  @@index([isGroup])
  @@map("chats")
}

// Group chat members
model ChatMember {
  id       String   @id @default(uuid())
  chatId   String
  userId   String
  joinedAt DateTime @default(now())
  isAdmin  Boolean  @default(false)

  chat     Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user     User     @relation("ChatMembers", fields: [userId],  references: [id], onDelete: Cascade)

  @@unique([chatId, userId])
  @@index([chatId])
  @@index([userId])
  @@map("chat_members")
}

model Message {
  id         String      @id @default(uuid())
  chatId     String
  senderId   String
  content    String      @db.Text
  type       MessageType @default(text)
  isRead     Boolean     @default(false)
  readAt     DateTime?
  metadata   Json?
  createdAt  DateTime    @default(now())

  chat       Chat        @relation(fields: [chatId],   references: [id], onDelete: Cascade)
  sender     User        @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([chatId])
  @@index([senderId])
  @@index([createdAt])
  @@map("messages")
}

// ─────────────────────────────────────────────────────────
//  NOTIFICATIONS
// ─────────────────────────────────────────────────────────
model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  message   String           @db.Text
  isRead    Boolean          @default(false)
  readAt    DateTime?
  actionUrl String?
  data      Json?
  createdAt DateTime         @default(now())

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

// ─────────────────────────────────────────────────────────
//  PAYMENTS / SUBSCRIPTIONS
// ─────────────────────────────────────────────────────────
model SubscriptionPlanConfig {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  description String?  @db.Text
  price       Int
  interval    String
  features    Json     @default("[]")
  isPopular   Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders      Order[]

  @@map("subscription_plans")
}

model Order {
  id                  String   @id @default(uuid())
  userId              String
  planId              String?
  razorpayOrderId     String   @unique
  razorpayPaymentId   String?
  razorpaySignature   String?
  amount              Int
  currency            String   @default("INR")
  status              String   @default("created")
  type                String   @default("subscription")
  tokenPack           Int?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user                User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                SubscriptionPlanConfig? @relation(fields: [planId],  references: [id])

  @@index([userId])
  @@index([razorpayOrderId])
  @@map("orders")
}

// ─────────────────────────────────────────────────────────
//  UPLOADS
// ─────────────────────────────────────────────────────────
model Upload {
  id        String       @id @default(uuid())
  userId    String
  folder    UploadFolder
  filename  String
  url       String       @db.Text
  mimeType  String?
  sizeBytes Int?
  createdAt DateTime     @default(now())

  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("uploads")
}

// ─────────────────────────────────────────────────────────
//  GAMIFICATION
// ─────────────────────────────────────────────────────────
model DailySwipe {
  id        String   @id @default(uuid())
  userId    String
  date      String
  count     Int      @default(0)

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
  @@map("daily_swipes")
}

model XpEvent {
  id        String   @id @default(uuid())
  userId    String
  action    String
  xpAmount  Int
  metadata  Json?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("xp_events")
}

// ─────────────────────────────────────────────────────────
//  ADMIN
// ─────────────────────────────────────────────────────────
model AdminUser {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  firstName    String?
  lastName     String?
  name         String?                          // CMS display name
  role         String    @default("custom")     // super_admin | blog_editor | seo_manager | website_manager | custom | SUPPORT | MODERATOR
  avatarUrl    String?
  isActive     Boolean   @default(true)
  status       String    @default("pending")    // active | pending | revoked (CMS)
  invitedBy    String?
  lastLoginAt  DateTime?
  lastActiveAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  auditLogs    AuditLog[]
  permissions  AdminPermission?
  articles     BlogArticle[]    @relation("BlogAuthor")

  @@map("admin_users")
}

model AuditLog {
  id          String    @id @default(uuid())
  adminId     String
  action      String
  entityType  String
  entityId    String?
  details     Json?
  ip          String?
  createdAt   DateTime  @default(now())

  admin       AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────────────────
//  CHALLENGES (V2)
// ─────────────────────────────────────────────────────────
model Challenge {
  id                  String   @id @default(uuid())
  title               String
  description         String   @db.Text
  type                String
  tier                Int      @default(1)
  activityType        String   @default("any")
  activityTag         String   @default("Any activity")
  environment         String   @default("any")
  cityId              String?
  startAt             DateTime
  endAt               DateTime
  xpPool              Int
  entryLevelRequired  Int      @default(1)
  trustRequired       Int      @default(0)
  maxParticipants     Int?
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  stations  ChallengeStation[]
  entries   ChallengeEntry[]  @relation("EntryChallenge")
  sessions  WorkoutSession[]  @relation("WorkoutChallenge")
  feedPosts ChallengeFeedPost[]

  @@index([tier])
  @@index([type])
  @@index([isActive])
  @@map("challenges")
}

model ChallengeStation {
  id               String  @id @default(uuid())
  challengeId      String
  stationNum       Int
  title            String
  description      String  @db.Text
  exerciseName     String  @default("")
  setsReps         String  @default("")
  proofInstruction String  @default("Upload a photo or video of your workout")
  verifyType       String  @default("count")
  targetValue      Int     @default(1)
  buddyRequired    Boolean @default(false)
  xpReward         Int

  challenge    Challenge           @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  completions  StationCompletion[]

  @@index([challengeId])
  @@map("challenge_stations")
}

model ChallengeEntry {
  id             String    @id @default(uuid())
  challengeId    String
  userId         String
  buddyId        String?
  status         String    @default("active")
  currentStation Int       @default(1)
  totalXpEarned  Int       @default(0)
  rankCity       Int?
  rankGlobal     Int?
  joinedAt       DateTime  @default(now())
  lastSessionAt  DateTime?
  completedAt    DateTime?

  challenge   Challenge           @relation("EntryChallenge", fields: [challengeId], references: [id], onDelete: Cascade)
  user        User                @relation("UserChallenges",  fields: [userId],   references: [id], onDelete: Cascade)
  buddy       User?               @relation("BuddyChallenges", fields: [buddyId],  references: [id], onDelete: SetNull)
  completions StationCompletion[]

  @@index([challengeId])
  @@index([userId])
  @@index([status])
  @@map("challenge_entries")
}

model StationCompletion {
  id             String   @id @default(uuid())
  entryId        String
  stationId      String
  stationNum     Int
  completedAt    DateTime @default(now())
  xpAwarded      Int
  progressValue  Int      @default(0)
  isCollab       Boolean  @default(false)

  entry   ChallengeEntry   @relation(fields: [entryId],   references: [id], onDelete: Cascade)
  station ChallengeStation @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@index([entryId])
  @@index([stationId])
  @@map("station_completions")
}

model ChallengeFeedPost {
  id              String   @id @default(uuid())
  challengeId     String
  userId          String
  stationNum      Int
  stationTitle    String
  postedAt        DateTime @default(now())
  expiresAt       DateTime // 24 hours after postedAt — auto-expire
  xpAwarded       Int
  proofImageUrl   String?  @db.Text
  isCollab        Boolean  @default(false)
  collabUserId    String?
  collabUserName  String?
  collabAvatarUrl String?  @db.Text
  activitySlug    String?
  caption         String?  @db.Text
  groupPhotoUrl   String?  @db.Text
  groupName       String?

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user      User      @relation("UserFeedPosts", fields: [userId], references: [id], onDelete: Cascade)

  @@index([challengeId])
  @@index([userId])
  @@map("challenge_feed_posts")
}

// ─────────────────────────────────────────────────────────
//  CMS — Website Admin Panel Models
// ─────────────────────────────────────────────────────────

// Blog articles
model BlogArticle {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  excerpt     String?  @db.Text
  content     String   @db.Text
  category    String   // member_story | challenge | fitness_industry | app_update | upcoming
  status      String   @default("draft") // draft | published
  authorId    String
  featuredImg String?
  metaTitle   String?
  metaDesc    String?  @db.Text
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author      AdminUser @relation("BlogAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([slug])
  @@index([status])
  @@index([category])
  @@map("blog_articles")
}

// SEO settings per page
model SeoPage {
  id          String   @id @default(uuid())
  pageKey     String   @unique // home | blog | download | blog_post
  pageUrl     String
  metaTitle   String
  metaDesc    String   @db.Text
  canonical   String?
  ogImage     String?
  hreflang    String   @default("en-IN")
  updatedAt   DateTime @updatedAt

  faqs        SeoFaq[]

  @@map("seo_pages")
}

// FAQ schema for AEO
model SeoFaq {
  id        String   @id @default(uuid())
  pageId    String
  question  String
  answer    String   @db.Text
  order     Int      @default(0)
  createdAt DateTime @default(now())

  page      SeoPage  @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId])
  @@map("seo_faqs")
}

// Website content (hero, stats, testimonials etc)
model WebsiteContent {
  id        String   @id @default(uuid())
  key       String   @unique // hero_headline | hero_sub | stat_1_val | testimonial_1 etc
  value     String   @db.Text
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@map("website_content")
}

// Social links
model SocialLink {
  id        String   @id @default(uuid())
  key       String   @unique // instagram | facebook | app_store | play_store | support_email
  label     String
  url       String
  updatedAt DateTime @updatedAt

  @@map("social_links")
}


// Per-user granular permissions
model AdminPermission {
  id              String   @id @default(uuid())
  adminId         String   @unique
  // Blog
  blogView        Boolean  @default(false)
  blogCreate      Boolean  @default(false)
  blogEdit        Boolean  @default(false)
  blogDelete      Boolean  @default(false)
  blogPublish     Boolean  @default(false)
  // SEO
  seoView         Boolean  @default(false)
  seoEditMeta     Boolean  @default(false)
  seoEditFaq      Boolean  @default(false)
  seoSitemap      Boolean  @default(false)
  // Website Content
  contentView     Boolean  @default(false)
  contentHero     Boolean  @default(false)
  contentStats    Boolean  @default(false)
  contentTestimon Boolean  @default(false)
  // Social
  socialView      Boolean  @default(false)
  socialEdit      Boolean  @default(false)
  // App Users
  appUsersView    Boolean  @default(false)
  appUsersBan     Boolean  @default(false)
  // Challenges
  challengesView  Boolean  @default(false)
  challengesCreate Boolean @default(false)
  challengesEdit  Boolean  @default(false)

  admin           AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@map("admin_permissions")
}

// ─────────────────────────────────────────────────────────
//  STRIKE 2 — Buddy Strike (Snap style)
// ─────────────────────────────────────────────────────────
model BuddyStrike {
  id          String    @id @default(uuid())
  senderId    String
  receiverId  String
  matchId     String
  imageUrl    String    @db.Text
  caption     String?
  reactEmoji  String?                  // 💪🔥😤🏆🤝😮
  viewedAt    DateTime?                // null = not viewed yet
  expiresAt   DateTime                 // 24hrs if not viewed, 5min after view
  createdAt   DateTime  @default(now())

  sender   User  @relation("StrikeSender",   fields: [senderId],   references: [id], onDelete: Cascade)
  receiver User  @relation("StrikeReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  match    Match @relation(fields: [matchId], references: [id],    onDelete: Cascade)

  @@index([senderId])
  @@index([receiverId])
  @@index([matchId])
  @@index([expiresAt])
  @@map("buddy_strikes")
}

// ─────────────────────────────────────────────────────────
//  INFLUENCER SYSTEM
// ─────────────────────────────────────────────────────────

model InfluencerApplication {
  id               String    @id @default(uuid())
  userId           String    @unique
  instagramHandle  String                          // "fitness_rahul_123"
  claimedFollowers Int                             // Self-reported by user
  verificationCode String                          // "SESHLLY-X7K9P2" auto-generated
  codeExpiresAt    DateTime                        // +7 days from apply
  status           String    @default("pending")   // pending|code_added|approved|rejected
  rejectedReason   String?
  canReapplyAt     DateTime?                       // +30 days from rejection
  reviewedBy       String?                         // Super Admin ID
  reviewedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user             User      @relation("UserApplication", fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([userId])
  @@map("influencer_applications")
}

// Track monthly session limit per influencer-fan pair
model InfluencerSession {
  id           String   @id @default(uuid())
  influencerId String
  fanId        String
  monthYear    String                              // "2025-08" format
  sessionCount Int      @default(0)               // Max 3 per month
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  influencer   User     @relation("InfluencerSessions", fields: [influencerId], references: [id], onDelete: Cascade)
  fan          User     @relation("FanSessions",         fields: [fanId],        references: [id], onDelete: Cascade)

  @@unique([influencerId, fanId, monthYear])
  @@index([influencerId])
  @@index([fanId])
  @@map("influencer_sessions")
}

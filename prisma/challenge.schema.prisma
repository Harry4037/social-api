// ─────────────────────────────────────────────────────────

model Challenge {
  id                  String   @id @default(uuid())
  title               String
  description         String
  type                String   // solo | duel | pack
  tier                Int      @default(1)
  cityId              String?
  startAt             DateTime
  endAt               DateTime
  xpPool              Int      @default(0)
  entryLevelRequired  Int      @default(1)
  trustRequired       Int      @default(0)
  maxParticipants     Int?
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  stations   ChallengeStation[]
  entries    ChallengeEntry[]
  feedPosts  ChallengeFeedPost[]
}

model ChallengeStation {
  id            String  @id @default(uuid())
  challengeId   String
  stationNum    Int
  title         String
  description   String
  verifyType    String  @default("count")
  targetValue   Int     @default(1)
  buddyRequired Boolean @default(false)
  xpReward      Int     @default(0)

  challenge   Challenge           @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  completions StationCompletion[]
}

model ChallengeEntry {
  id             String    @id @default(uuid())
  challengeId    String
  userId         String
  buddyId        String?
  status         String    @default("active") // active | completed | dormant | dropped
  currentStation Int       @default(1)
  totalXpEarned  Int       @default(0)
  rankCity       Int?
  rankGlobal     Int?
  joinedAt       DateTime  @default(now())
  lastSessionAt  DateTime?
  completedAt    DateTime?

  challenge   Challenge           @relation(fields: [challengeId], references: [id])
  user        User                @relation("UserChallenges",  fields: [userId],   references: [id])
  buddy       User?               @relation("BuddyChallenges", fields: [buddyId],  references: [id])
  completions StationCompletion[]
}

model StationCompletion {
  id            String   @id @default(uuid())
  entryId       String
  stationId     String
  stationNum    Int
  completedAt   DateTime @default(now())
  xpAwarded     Int      @default(0)
  progressValue Int      @default(0)
  isCollab      Boolean  @default(false)

  entry   ChallengeEntry   @relation(fields: [entryId],   references: [id], onDelete: Cascade)
  station ChallengeStation @relation(fields: [stationId], references: [id])
}

model ChallengeFeedPost {
  id              String   @id @default(uuid())
  challengeId     String
  userId          String
  stationNum      Int
  stationTitle    String
  postedAt        DateTime @default(now())
  xpAwarded       Int      @default(0)
  proofImageUrl   String?
  isCollab        Boolean  @default(false)
  collabUserId    String?
  collabUserName  String?
  collabAvatarUrl String?
  activitySlug    String?

  challenge Challenge @relation(fields: [challengeId], references: [id])
  user      User      @relation(fields: [userId],      references: [id])
}

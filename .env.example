# ── Server ────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
API_VERSION=v1

# ── Database ──────────────────────────────────────────────
# connection_limit: Prisma's default is only (2 x CPU + 1) = 5 on a 2-vCPU box.
# The 1000-user load test ran out of connections at 5 → use 20 (MySQL allows 151).
# With N API instances keep N x connection_limit under the DB's max_connections.
DATABASE_URL="mysql://root:password@localhost:3306/fitconnect?connection_limit=20&pool_timeout=20"

# ── JWT ───────────────────────────────────────────────────
JWT_ACCESS_SECRET=your_super_secret_access_key_change_in_production_min_32_chars
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_in_production_min_32_chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d
ADMIN_JWT_SECRET=your_admin_jwt_secret_different_from_user_secret_min_32_chars

# ── Razorpay ──────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
# Razorpay Dashboard → Webhooks → URL https://<api>/api/v1/subscriptions/webhook,
# events payment.captured + order.paid. Paid-but-app-closed orders still complete.
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ── File Upload ───────────────────────────────────────────
UPLOAD_DIR=uploads

# ── Rate Limiting ─────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=10

# ── CORS ─────────────────────────────────────────────────
# Include all origins that need access:
#   Android emulator  → http://10.0.2.2:PORT  (maps to host machine)
#   iOS simulator     → http://localhost:PORT
#   Web dev           → http://localhost:3000
#   Physical device   → your machine's LAN IP, e.g. http://192.168.1.5:PORT
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000,http://10.0.2.2:5000,http://192.168.1.5:5000

# ── Logs ──────────────────────────────────────────────────
LOG_LEVEL=debug
LOG_DIR=logs

# ── Round 2 additions ─────────────────────────────
# Proxies in front of the API (nginx / load balancer). 0 = API exposed directly.
TRUST_PROXY=1
# AI fake-proof check (Hive). Empty = check skipped.
HIVE_API_KEY=your_hive_api_key
# Firebase push — path to service account JSON (default: ./firebase-service-account.json)
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# Gym map — Google Places API (New). Empty = map shows "not configured".
GOOGLE_MAPS_API_KEY=your_google_maps_server_key

# ── Email (forgot-password codes) ─────────────────────────
# Gmail: use an App Password. Or SES / Zoho / Mailgun SMTP.
# Without SMTP_HOST the code is only written to the server log.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your_app_password
MAIL_FROM="Seshlly <no-reply@seshlly.com>"

# Security contact shown in /.well-known/security.txt
SECURITY_CONTACT=security@seshlly.com
# Admin 2-factor secrets are encrypted with this (defaults to ADMIN_JWT_SECRET)
# ADMIN_2FA_KEY=

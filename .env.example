# ── Server ────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
API_VERSION=v1

# ── Database ──────────────────────────────────────────────
DATABASE_URL="mysql://root:password@localhost:3306/fitconnect"

# ── JWT ───────────────────────────────────────────────────
JWT_ACCESS_SECRET=your_super_secret_access_key_change_in_production_min_32_chars
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_in_production_min_32_chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d
ADMIN_JWT_SECRET=your_admin_jwt_secret_different_from_user_secret_min_32_chars

# ── Razorpay ──────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret

# ── File Upload ───────────────────────────────────────────
UPLOAD_DIR=uploads

# ── Rate Limiting ─────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=10

# ── CORS ─────────────────────────────────────────────────
# Include all origins that need access:
#   Android emulator  → http://10.0.2.2:PORT  (maps to host machine)
#   iOS simulator     → http://localhost:PORT
#   Web dev           → http://localhost:3000
#   Physical device   → your machine's LAN IP, e.g. http://192.168.1.5:PORT
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000,http://10.0.2.2:5000,http://192.168.1.5:5000

# ── Logs ──────────────────────────────────────────────────
LOG_LEVEL=debug
LOG_DIR=logs

# ── Round 2 additions ─────────────────────────────
# Proxies in front of the API (nginx / load balancer). 0 = API exposed directly.
TRUST_PROXY=1
# AI fake-proof check (Hive). Empty = check skipped.
HIVE_API_KEY=your_hive_api_key
# Firebase push — path to service account JSON (default: ./firebase-service-account.json)
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# Gym map — Google Places API (New). Empty = map shows "not configured".
GOOGLE_MAPS_API_KEY=your_google_maps_server_key
